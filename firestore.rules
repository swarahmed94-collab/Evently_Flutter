rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function validEvent() {
      return request.resource.data.keys().hasAll(['ownerId', 'title', 'description', 'category', 'dateTime', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'title', 'description', 'category', 'dateTime', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 10000
        && request.resource.data.category in ['book_club', 'sport', 'birthday', 'meeting', 'exhibition']
        && request.resource.data.dateTime is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validEvent();
      allow update: if owner() && validEvent() && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner();
    }
    match /users/{userId}/favorites/{eventId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && exists(/databases/$(database)/documents/events/$(eventId))
        && request.resource.data.keys().hasOnly(['eventId', 'createdAt'])
        && request.resource.data.eventId == eventId;
    }
  }
}
